# ===== Generated artifacts (avoid re-pushing huge runs) =====

# model/run caches
cache/
outputs/

# python caches
__pycache__/
**/__pycache__/
*.pyc

# logs
vllm_logs_*/

# large synthesis outputs (generated)
synthesis_output_*/
synth_pilot_*/
synth_eval_*/

# MVP run outputs and logs
test_output_*/
test_output_*.log
.DS_Store

# probing run intermediates and per-model outputs
runs/*/checkpoints/
runs/*/hidden_*.npy
runs/*/model_outputs.jsonl
runs/*/item_index.jsonl
runs/*/capability_labels.json
runs/*/linear_probe.json
runs/*/lora_probe.json
runs/*/probe_geometry.*
runs_*.log

# editor temp files
.~*


# ===== Local-only files =====
CLAUDE.md
.claude/
.CLAUDE.md.local
*.local

# Secrets / API config (never commit)
**/api_token*
**/.env
**/*.token
**/secrets.py
